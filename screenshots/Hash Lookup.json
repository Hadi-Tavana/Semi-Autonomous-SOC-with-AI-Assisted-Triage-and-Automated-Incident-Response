      "parameters": {
        "jsCode": "return $input.all().map((item, index) => {\n\n  const triggerItems = $items(\"Execute Workflow Trigger\");\n  const originalItem = triggerItems[index]?.json || {};\n\n  // ✅ FIX\n  const originalAlert = originalItem.alert || originalItem;\n\n  const vtResult = item.json;\n\n  return {\n    json: {\n      alert_id: originalAlert.alert_id || \"unknown\",\n      type: originalItem.type || \"hash\",\n      value: originalItem.value || vtResult.data?.id || \"unknown\",\n\n      // ✅ FIXED\n      alert: originalAlert,\n\n      lookup_result: {\n        virustotal: vtResult.data ? {\n          link: vtResult.data.links?.self || `https://www.virustotal.com/gui/file/${vtResult.data.id}`,\n          stats: vtResult.data.attributes?.last_analysis_stats || null,\n          reputation: vtResult.data.attributes?.reputation || null,\n          names: vtResult.data.attributes?.names || [],\n          meaningful_name: vtResult.data.attributes?.meaningful_name || null,\n          tags: vtResult.data.attributes?.tags || [],\n          raw: vtResult\n        } : null,\n        hybrid_analysis: null,\n        malwarebazaar: null\n      }\n    }\n  };\n});"
      },
