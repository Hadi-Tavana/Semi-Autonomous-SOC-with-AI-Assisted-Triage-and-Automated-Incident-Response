    {
      "parameters": {
        "jsCode": "return $input.all().map((item, index) => {\n\n  // ✅ Always use deterministic indexing\n  const triggerItems = $items(\"Execute Workflow Trigger\");\n  const originalItem = triggerItems[index]?.json || {};\n\n  // ✅ FIX: support BOTH structures (flat + nested)\n  const originalAlert = originalItem.alert || originalItem;\n\n  const indicatorValue = originalItem.value || \"unknown\";\n\n  // ✅ OSINT results\n  const vtData = $items(\"VirusTotal Domain Search\")[index]?.json || {};\n  const urlscanData = $items(\"urlscan Domain Search\")[index]?.json || {};\n\n  return {\n    json: {\n      alert_id: originalAlert.alert_id || \"unknown\",\n      type: \"domain\",\n      value: indicatorValue,\n\n      // ✅ FIXED: now contains full alert\n      alert: originalAlert,\n\n      lookup_result: {\n        virustotal: vtData.data ? {\n          link: `https://www.virustotal.com/gui/domain/${indicatorValue}`,\n          stats: vtData.data.attributes?.last_analysis_stats || null,\n          reputation: vtData.data.attributes?.reputation || 0,\n          categories: vtData.data.attributes?.categories || {},\n          raw: vtData\n        } : null,\n        urlscan: {\n          link: urlscanData.result || null,\n          screenshot: urlscanData.screenshot || null,\n          overall_score: urlscanData.verdicts?.overall?.score || 0,\n          malicious: urlscanData.verdicts?.overall?.malicious || false,\n          raw: urlscanData\n        },\n        hybrid_analysis: null,\n        malwarebazaar: null\n      }\n    }\n  };\n});"
      },
